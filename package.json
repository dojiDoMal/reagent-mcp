{
  "name": "react-debug-mcp",
  "version": "0.1.0",
  "description": "Agent-oriented React debugging via MCP. Dev-only runtime that lets an MCP agent inspect a running React app's Redux state, storage and runtime errors.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "react-debug-mcp": "./dist/server/cli.js"
  },
  "exports": {
    "./react": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "redux",
    "mcp",
    "debugging",
    "devtools"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jsan": "^3.1.14",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
